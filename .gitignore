# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files that may contain sensitive data
*.tfvars
!*.tfvars.example
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file is committed for apps; modules may omit - we commit root stack locks
# .terraform.lock.hcl

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Plan artifacts
*.tfplan
plans/
out/
